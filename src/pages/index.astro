---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Clients from '@/components/Clients.astro';
import Services from '@/components/Services.astro';
import HowItFitsTogether from '@/components/HowItFitsTogether.astro';
import About from '@/components/About.astro';
import ProofOfWork from '@/components/ProofOfWork.astro';
import ContactSection from '@/components/ContactSection.astro';
import Footer from '@/components/Footer.astro';
---

<BaseLayout title="DevCult — DevEx & DevRel for web3 ecosystems.">
  <Header />
  <main id="main-content">
    <Hero />
    <Clients />
    <Services />
    <HowItFitsTogether />
    <About />
    <ProofOfWork />
    <ContactSection />
  </main>
  <Footer />
</BaseLayout>
