---
import { footerLinks, socialLinks } from '@/data/navigation';
---

<footer class="border-t border-border-primary bg-bg-secondary">
  <div class="mx-auto max-w-7xl px-6 py-7">
    <!-- Top row: logo | nav links | social icons -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 md:relative">
      <a
        id="footer-logo"
        href="#"
        class="flex items-center gap-3 font-semibold font-coconat text-xl"
      >
        <img src="/monogram.webp" alt="DevCult Logo" class="footer-logo-image" loading="lazy" />
        DevCult
      </a>

      <nav
        class="flex flex-wrap gap-8 md:absolute md:left-1/2 md:top-1/2 md:-translate-x-1/2 md:-translate-y-1/2"
      >
        {
          footerLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-text-secondary hover:text-accent transition-all hover:translate-y-[-1px]"
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-3">
        {
          socialLinks.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith('mailto') ? undefined : '_blank'}
              rel={link.href.startsWith('mailto') ? undefined : 'noopener'}
              class="social-icon p-2.5 rounded-lg text-text-secondary hover:text-accent hover:bg-brand-alpha-10 transition-all"
              aria-label={link.label}
            >
              {link.icon === 'x' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.748l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              )}
              {link.icon === 'github' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
                </svg>
              )}
              {link.icon === 'linkedin' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
                </svg>
              )}
              {link.icon === 'mail' && (
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
              )}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Bottom row: copyright | legal links -->
    <div class="mt-5 flex flex-col md:flex-row md:items-center gap-3">
      <div class="flex-1"></div>
      <p class="flex-1 text-xs text-accent text-center">© {new Date().getFullYear()} DevCult. All rights reserved.</p>
      <div class="flex-1 flex items-center gap-4 md:justify-end">
        <a href="/legal#terms" class="text-xs text-text-tertiary hover:text-text-secondary transition-colors">Terms & Conditions</a>
        <a href="/legal#privacy" class="text-xs text-text-tertiary hover:text-text-secondary transition-colors">Privacy Policy</a>
      </div>
    </div>

  </div>
</footer>

<!-- Back to top button -->
<button
  id="back-to-top"
  class="fixed bottom-8 right-8 p-3 rounded-full bg-bg-secondary border border-border-primary text-text-secondary hover:text-accent hover:border-accent transition-all opacity-0 pointer-events-none"
  aria-label="Back to top"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="2"
      d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
  </svg>
</button>

<script>
  const footerLogo = document.getElementById('footer-logo');
  const backToTopButton = document.getElementById('back-to-top');

  function scrollToTop(e: Event) {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  footerLogo?.addEventListener('click', scrollToTop);
  backToTopButton?.addEventListener('click', scrollToTop);
</script>

<style>
  .footer-logo-image {
    width: 32px;
    height: auto;
    object-fit: contain;
    background: transparent;
    transition: transform 0.2s ease;
  }

  #footer-logo:hover .footer-logo-image {
    transform: scale(1.05);
  }

  .social-icon:hover {
    transform: translateY(-2px) scale(1.05);
  }
</style>
