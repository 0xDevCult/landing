---
const services = [
  {
    id: 'devex',
    title: 'Developer Experience',
    body: 'The first 30 minutes decide everything. We audit your entire developer journey — from landing page to first successful API call — and eliminate the friction that turns developers away before they ever ship. Docs that are AI-first and human-clear. Onboarding flows that go from hours to minutes. Error messages that actually explain the problem.',
    imageAlt: 'Developer Experience illustration',
    imageRight: true,
  },
  {
    id: 'ai-enablement',
    title: 'AI Enablement',
    body: 'AI agents read your docs before developers do — and most docs fail both audiences. We restructure your technical content to be machine-parseable and LLM-friendly, so your ecosystem thrives in the age of AI-assisted development. MCP servers, AI-readable references, context files, and structured knowledge bases that make your stack the go-to for AI-native builders.',
    imageAlt: 'AI Enablement illustration',
    imageRight: false,
  },
  {
    id: 'hackathons',
    title: 'Developer Events & Hackathons',
    body: 'Our signature model. End-to-end hackathon design and execution — from challenge crafting to judging to winner follow-up. We show up not as sponsors with swag, but as a coordinated team of operators who drive measurable developer adoption. Pre-event activation, on-site technical support, real-time feedback loops, and post-event incubation to turn weekend projects into retained builders.',
    imageAlt: 'Developer Events and Hackathons illustration',
    imageRight: true,
  },
];
---

<section id="main-services" class="py-24 bg-bg-primary">
  <div class="mx-auto max-w-7xl px-6">
    <h2 data-animate class="text-4xl md:text-5xl font-[750] font-coconat text-text-primary mb-20 text-center">
      Our Services
    </h2>
    <div class="flex flex-col gap-28 md:gap-36">
      {
        services.map((service) => (
          <div
            data-animate
            class={`flex flex-col gap-12 md:gap-16 items-center ${service.imageRight ? 'md:flex-row' : 'md:flex-row-reverse'}`}
          >
            <!-- Text -->
            <div class="flex-1 flex flex-col gap-6">
              <h2 class="text-3xl md:text-4xl lg:text-5xl font-[750] font-coconat leading-[1.1] text-text-primary">
                {service.title}
              </h2>
              <p class="text-base md:text-lg text-text-secondary leading-relaxed max-w-xl">
                {service.body}
              </p>
            </div>

            <!-- Image placeholder -->
            <div class="flex-1 w-full">
              <div class="service-image-placeholder w-full aspect-[4/3] rounded-2xl flex items-center justify-center">
                <span class="text-brand-500/40 font-coconat text-sm tracking-widest uppercase">
                  {service.imageAlt}
                </span>
              </div>
            </div>
          </div>
        ))
      }

      <!-- Hackathon stat cards -->
      <div data-animate class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="stat-card rounded-2xl p-6 flex flex-col gap-3">
          <p class="text-xs font-coconat tracking-widest uppercase text-brand-500/60">Hackathons</p>
          <p class="text-5xl font-[750] font-coconat text-text-primary">50+</p>
          <p class="text-sm text-text-secondary">Events run worldwide</p>
        </div>
        <div class="stat-card rounded-2xl p-6 flex flex-col gap-3">
          <p class="text-xs font-coconat tracking-widest uppercase text-brand-500/60">Developers</p>
          <p class="text-5xl font-[750] font-coconat text-text-primary">10k+</p>
          <p class="text-sm text-text-secondary">Reached across ecosystems</p>
        </div>
        <div class="stat-card rounded-2xl p-6 flex flex-col gap-3">
          <p class="text-xs font-coconat tracking-widest uppercase text-brand-500/60">Projects</p>
          <p class="text-5xl font-[750] font-coconat text-text-primary">200+</p>
          <p class="text-sm text-text-secondary">Built and incubated</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stat-card {
    background: linear-gradient(
      135deg,
      rgba(255, 106, 0, 0.06) 0%,
      rgba(255, 106, 0, 0.02) 50%,
      rgba(255, 106, 0, 0.08) 100%
    );
    border: 1px solid rgba(255, 106, 0, 0.2);
  }

  .service-image-placeholder {
    background: linear-gradient(
      135deg,
      rgba(255, 106, 0, 0.06) 0%,
      rgba(255, 106, 0, 0.02) 50%,
      rgba(255, 106, 0, 0.08) 100%
    );
    border: 1px solid rgba(255, 106, 0, 0.2);
  }
</style>
