---
import { Image } from 'astro:assets';
import bannerImage from '@/assets/images/banner.png';
---

<section class="min-h-screen flex items-center">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex flex-col gap-10">
      <div>
        <h1
          data-animate
          class="text-4xl md:text-5xl lg:text-6xl font-[750] leading-[1.05] font-coconat"
        >
          If you want to compete in <span
            class="text-transparent bg-clip-text"
            style="background-image: linear-gradient(to right, var(--color-brand-400), var(--color-brand-500), var(--color-brand-300));"
            >opensource</span
          >, make it a <span class="relative inline-block"
            ><span
              class="absolute bottom-0 left-0 right-0 h-1 rounded-full"
              style="background-image: linear-gradient(to right, var(--color-brand-400), var(--color-brand-500), var(--color-brand-300));"
            ></span>heaven for devs</span
          >.
        </h1>
      </div>
      <div data-animate data-delay="100">
        <div class="relative">
          <Image
            src={bannerImage}
            alt="DevCult Banner - Developer Experience Excellence"
            class="w-full h-auto object-cover rounded-xl shadow-2xl"
            loading="eager"
            widths={[640, 768, 1024, 1280, 1536]}
            sizes="(max-width: 768px) 640px, (max-width: 1024px) 768px, 1280px"
            format="webp"
          />
        </div>
      </div>
      <!-- Value Cards -->
      <div data-animate data-delay="200" class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-2">
        <!-- What We Do -->
        <div class="p-5 rounded-xl border border-brand-500/30 bg-brand-500/5 hover:bg-brand-500/10 transition-all">
          <h3 class="text-sm font-semibold text-brand-400 uppercase tracking-wider mb-2">What We Do</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            DevEx & DevRel for web3 ecosystems. We fix what turns developers out of blockchains.
          </p>
        </div>

        <!-- AI-First Docs -->
        <div class="p-5 rounded-xl border border-brand-500/30 bg-brand-500/5 hover:bg-brand-500/10 transition-all">
          <h3 class="text-sm font-semibold text-brand-400 uppercase tracking-wider mb-2">The New Standard</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Onboarding is for humans. Documentation should be AI-first. We build for the new age of software development.
          </p>
        </div>

        <!-- Mission -->
        <div class="p-5 rounded-xl border border-brand-500/30 bg-brand-500/5 hover:bg-brand-500/10 transition-all">
          <h3 class="text-sm font-semibold text-brand-400 uppercase tracking-wider mb-2">Our Mission</h3>
          <p class="text-sm text-text-secondary leading-relaxed">
            Making every blockchain ecosystem a place where developers thrive, not just survive.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
