---
const clients = [
  {
    name: 'Web3 Foundation',
    logo: '/images/clients/w3f-logo.svg',
    alt: 'Web3 Foundation',
    url: 'https://web3.foundation',
  },
  {
    name: 'Polkadot',
    logo: '/images/clients/polkadot-logo.svg',
    alt: 'Polkadot',
    url: 'https://polkadot.com',
  },
  {
    name: 'Parity',
    logo: '/images/clients/parity_logo.svg',
    alt: 'Parity Technologies',
    url: 'https://parity.io',
  },
  {
    name: 'ink!',
    logo: '/images/clients/ink-logo.svg',
    alt: 'ink! smart contracts',
    url: 'https://use.ink',
  },
];
---

<section id="clients" class="py-16 border-y border-border-primary bg-bg-secondary">
  <div class="mx-auto max-w-7xl px-6">
    <h2 data-animate class="text-center text-3xl md:text-4xl font-coconat font-bold mb-16">
      Trusted by
    </h2>
    <div
      data-animate
      data-delay="100"
      class="flex justify-center items-center gap-16 md:gap-20 flex-wrap"
    >
      {
        clients.map((client) => (
          <a
            href={client.url}
            target="_blank"
            rel="noopener noreferrer"
            class="client-logo h-10 w-40 flex items-center justify-center overflow-hidden transition-all"
          >
            <img src={client.logo} alt={client.alt} class="h-full w-full object-contain" />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .client-logo {
    opacity: 0.7;
    filter: sepia(100%) saturate(300%) brightness(0.9) hue-rotate(-5deg);
    transition: all 0.3s ease;
  }

  .client-logo:hover {
    opacity: 1;
    filter: none;
    transform: scale(1.05);
  }

  .client-logo img {
    transition: all 0.3s ease;
  }
</style>
